; ============================================================
; GROMACS MDP - Energy Minimization
; ============================================================
integrator   = steep
emtol        = 1000.0
emstep       = 0.01
nsteps       = 50000

; Output
nstxout      = 500
nstlog       = 500
nstenergy    = 500

; Cutoffs
cutoff-scheme   = Verlet
nstlist         = 20
ns_type         = grid
rlist           = 1.2
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = Cut-off
rvdw            = 1.2
DispCorr        = EnerPres

; Constraints
constraints     = h-bonds
constraint-algorithm = LINCS
